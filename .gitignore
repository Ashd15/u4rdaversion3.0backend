*.env
.env.*

# Coverage / test reports
.coverage
htmlcov/
.coverage.*
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# OS generated
.DS_Store
Thumbs.db
desktop.ini
