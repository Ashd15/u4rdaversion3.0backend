# Python cache / compiled files
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb

# Virtual environments
myenv/
venv/
.env/
env/

# IDE & Editor settings
.vscode/
.idea/
*.swp
*.swo

# Django specific
*.log
*.pot
*.pyc
